# PipelineX Backend Production Environment Template

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL - Neon / RDS / Supabase)
DATABASE_URL="postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/pipelinex_db?sslmode=require"

# Redis & Queue Configuration (Upstash / Managed Redis)
# Option 1: REDIS_URL Connection String (Recommended for Cloud Providers)
REDIS_URL="rediss://default:your-upstash-redis-password@bright-lion-12345.upstash.io:6379"

# Option 2: Individual Redis Connection Host Parameters
REDIS_HOST="bright-lion-12345.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your-upstash-redis-password"
REDIS_TLS=true

# JWT Authentication Secrets
JWT_ACCESS_SECRET="generate-a-secure-random-64-character-hex-string-for-access"
JWT_REFRESH_SECRET="generate-a-secure-random-64-character-hex-string-for-refresh"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cloudflare R2 / AWS S3 Object Storage Configuration
R2_ACCESS_KEY_ID="your-cloudflare-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-cloudflare-r2-secret-access-key"
R2_BUCKET_NAME="pipelinex-production-uploads"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_REGION="auto"

# CORS Allowed Origins (Comma separated for multiple domains)
ALLOWED_ORIGINS="https://pipelinex.vercel.app,http://localhost:5173"
