# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://pipelinex_user:pipelinex_password@localhost:5432/pipelinex_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiration
JWT_ACCESS_SECRET="super-secret-access-key-change-in-production-12345"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-67890"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cloudflare R2 / S3 Object Storage Configuration
R2_ACCESS_KEY_ID="mock-access-key-id"
R2_SECRET_ACCESS_KEY="mock-secret-access-key"
R2_BUCKET_NAME="pipelinex-uploads"
R2_ENDPOINT="http://localhost:4566"
R2_REGION="auto"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000"
