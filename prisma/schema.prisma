datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Baseline placeholder model for Prisma initialization
model HealthCheck {
  id        String   @id @default(uuid())
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}
